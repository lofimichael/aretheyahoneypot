{
  "name": "aretheyahoneypot",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && npm run db:local && wrangler dev --port 8790",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "lint": "node scripts/check.mjs",
    "test": "vitest run",
    "db:local": "wrangler d1 migrations apply aretheyahoneypot --local",
    "e2e": "playwright test",
    "assets": "node scripts/gen-assets.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run lint",
    "deploy": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261113.1",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource/courier-prime": "^5.3.0",
    "@fontsource/lilita-one": "^5.3.0",
    "@playwright/test": "^1.65.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^4.1.12",
    "wrangler": "^4.161.0"
  }
}
